name: Build Android App

on:name: Build Educational App APK

on:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: 18

      - name: Install Dependencies
        run: npm install

      - name: Build Status Notice
        run: echo "تم تجهيز هيكل تطبيق التلوين، الكتابة، والألغاز بنجاح للتشغيل!"

