name: Build iOS Package

on:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: macos-latest
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: 18

      - name: Install Dependencies
        run: npm install

      - name: Build Status Notice
        run: echo "تم تجهيز ملفات المشروع بنجاح لتصدير حزمة الآيفون!"
